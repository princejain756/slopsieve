+// This function formats a price for display
+export function formatPrice(cents) {
+  // Convert cents to dollars and format
+  return "$" + (cents / 100).toFixed(2);
+}
+
+export function discountHelperUnused(total) {
+  try {
+    return total * 0.9;
+  } catch (e) {}
+}
